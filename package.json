{
  "name": "chat-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production E2EE Chat System Monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @chat/database run db:generate",
    "db:push": "pnpm --filter @chat/database run db:push",
    "db:migrate": "pnpm --filter @chat/database run db:migrate",
    "db:studio": "pnpm --filter @chat/database run db:studio",
    "test:load": "docker compose run --rm k6 run /scripts/message-throughput.js"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
