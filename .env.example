# Supabase PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Server & Gateway Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Ephemeral State & Redis Bus
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="replace-with-secure-random-secret-in-production"
JWT_EXPIRATION="7d"

# AWS / S3 E2EE Attachment Storage (India Region: ap-south-1)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="chat-app-e2ee-attachments"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
